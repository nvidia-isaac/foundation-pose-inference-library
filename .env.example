# Copy to .env and adjust. Consumed by compose.yaml (docker compose).

# Host user/group so container-written files (build/, engine_cache/, results)
# stay owned by you:  echo "FP_UID=$(id -u)" ; echo "FP_GID=$(id -g)"
FP_UID=1000
FP_GID=1000

# Host directory that contains BOP_datasets/ (mounted at /work/data).
FP_DATA_DIR=./data

# Host directory that contains refiner_net.onnx + score_net.onnx
# (https://huggingface.co/nvidia/foundationpose; mounted at /work/weights).
FP_WEIGHTS_DIR=./weights

# Host directory for cached TensorRT plans (mounted at /work/engine_cache).
FP_ENGINE_CACHE_DIR=./engine_cache

# Parallel compile jobs for `docker compose run --rm build`.
BUILD_JOBS=4
